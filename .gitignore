# --- data: never commit. Everything here is re-fetchable via scripts/download_data.py
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep
!data/splits/*.json          # splits are small, and reproducibility depends on them

# --- environments and upstream checkouts
envs/
external/*/
!external/README.md

# --- experiment outputs
# Figures and metrics ARE tracked: they are the evidence the write-ups cite, and
# they are small. Heavy regenerable artifacts are not.
#
# Per-view model intermediates are NOT evidence: a full Foot3D run writes
# rgb/mask/toc/normal PNGs for all 474 views, which is 485 MB of regenerable
# output. Ignore the per-view directories and keep the summary figures/metrics.
experiments/focus_baseline/foot3d/*/*/
experiments/focus_baseline/synthetic/*/
experiments/**/*.stl
experiments/**/*.step
experiments/**/*.ply
experiments/**/*.obj
experiments/**/*.mp4
experiments/**/*.pt
experiments/**/*.ckpt
experiments/**/*.npy
experiments/**/*.npz

# --- python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- os / editor
.DS_Store
.vscode/
.idea/

# --- FOCUS port: large downloaded/derived assets (re-fetchable)
experiments/focus_baseline/render*/
experiments/focus_baseline/predictions*/
experiments/focus_baseline/sfm_run*/
experiments/focus_baseline/synthetic/*_rgb/
experiments/focus_baseline/synthetic/*_run/
