# --- data: never commit. Everything here is re-fetchable via scripts/download_data.py
data/raw/**
data/processed/**
data/external/**
!data/**/.gitkeep
!data/splits/*.json          # splits are small, and reproducibility depends on them

# --- environments and upstream checkouts
envs/
external/*/
!external/README.md

# --- experiment outputs
# Figures and metrics ARE tracked: they are the evidence the write-ups cite, and
# they are small. Heavy regenerable artifacts are not.
experiments/**/*.stl
experiments/**/*.step
experiments/**/*.ply
experiments/**/*.obj
experiments/**/*.mp4
experiments/**/*.pt
experiments/**/*.ckpt
experiments/**/*.npy
experiments/**/*.npz

# --- python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- os / editor
.DS_Store
.vscode/
.idea/
